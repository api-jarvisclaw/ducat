{
  "name": "ducat",
  "version": "0.1.0",
  "description": "A terminal AI agent with its own wallet — 4000+ APIs and 80+ models, paid per call over x402.",
  "license": "MIT",
  "author": "JarvisClaw",
  "homepage": "https://jarvisclaw.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/api-jarvisclaw/ducat.git"
  },
  "bugs": "https://github.com/api-jarvisclaw/ducat/issues",
  "keywords": [
    "ducat",
    "ai",
    "agent",
    "cli",
    "x402",
    "usdc",
    "llm",
    "api",
    "marketplace",
    "wallet"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ducat": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@jarvisclaw-ai/sdk": "^0.1.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsup": "8.5.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
